{
  "name": "relay-dsh-plugin-monitor-time",
  "version": "0.1.2-rc.1",
  "description": "Time deadline Monitor Bundle extension for Relay on DeepSeek Harness.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "monitoring",
    "monitor-bundles",
    "timer"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./host-plugin.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangbobo2021/relay-dsh-plugin-monitor-time.git"
  },
  "homepage": "https://github.com/yangbobo2021/relay-dsh-plugin-monitor-time#readme",
  "bugs": {
    "url": "https://github.com/yangbobo2021/relay-dsh-plugin-monitor-time/issues"
  },
  "exports": {
    ".": "./host-plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SPEC.md",
    "docs",
    "cordis.patch.yml",
    "host-plugin.js",
    "agent-bridge.js",
    "src"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "node --check host-plugin.js && node --check agent-bridge.js && node --check src/time-bundle.mjs",
    "build": "npm run typecheck",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.1.2-0 || >=0.1.2-alpha.2 <0.1.3-0",
    "relay-dsh-plugin-events": "0.2.3-rc.1",
    "relay-dsh-plugin-monitors": "0.3.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "relay-dsh-plugin-events": {
      "optional": true
    },
    "relay-dsh-plugin-monitors": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "relay-dsh-plugin-events": "github:yangbobo2021/relay-dsh-plugin-events#15fa90a2dd036e3b8a3ba2c8059d10814b795692",
    "relay-dsh-plugin-monitors": "github:yangbobo2021/relay-dsh-plugin-monitors#fb21417cec72df9558fa8ccbe6ce5f61b8c3a15a"
  }
}
